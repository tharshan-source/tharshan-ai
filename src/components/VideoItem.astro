---
/**
 * A video entry, presented like any other piece of work: text first.
 * A thumbnail is shown only if one is set in the frontmatter.
 */
import { Image } from 'astro:assets';
import type { Video } from '../lib/content';
import { dotDate, isoDate } from '../lib/content';
interface Props { entry: Video; compact?: boolean }
const { entry, compact = false } = Astro.props;
const { title, description, date, platform, url, thumbnail, thumbnailAlt, duration } = entry.data;
---
<li class:list={['video', { compact }]}>
  <a href={url} target="_blank" rel="noopener">
    {thumbnail && <Image src={thumbnail} alt={thumbnailAlt ?? ''} widths={[360, 720]} sizes="(min-width: 60rem) 20rem, 100vw" class="thumb" />}
    <p class="meta">
      <span><span class="a" aria-hidden="true">▸ </span>{duration ?? 'video'}</span>
      <span>{platform.toLowerCase()}</span>
      <time datetime={isoDate(date)}>{dotDate(date)}</time>
    </p>
    <h3 class="t">{title}<span class="visually-hidden"> (watch on {platform}, opens in a new tab)</span></h3>
    {!compact && <p class="d">{description}</p>}
  </a>
</li>
<style>
  .video { border-top: 1px solid var(--rule); }
  a { display: block; padding-block: 1.25rem 1.5rem; text-decoration: none; color: inherit; }
  .t { font-size: 1.2rem; line-height: 1.3; margin-top: 0.55rem; letter-spacing: -0.01em; transition: color 120ms ease; }
  a:hover .t { color: var(--accent-2); }
  .d { color: var(--muted); font-size: 1rem; line-height: 1.5; margin-top: 0.4rem; max-width: 38rem; }
  .thumb { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border: 1px solid var(--rule); margin-bottom: 1rem; }
  .video:not(.compact) { border-top: 0; border-bottom: 1px solid var(--rule); }
  @media (min-width: 60rem) {
    .video:not(.compact) a { display: grid; grid-template-columns: var(--side) minmax(0, 1fr); column-gap: 3rem; }
    .video:not(.compact) .meta { grid-row: 1 / span 2; flex-direction: column; gap: 0.3rem; }
    .video:not(.compact) .meta > * + *::before { content: none; }
    .video:not(.compact) .t { margin-top: 0; }
    .video:not(.compact) .thumb { grid-column: 2; }
  }
</style>
