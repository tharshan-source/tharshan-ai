---
/** A copyable citation block. Tiny inline script, no dependencies. */
interface Props { apa: string; bibtex?: string }
const { apa, bibtex } = Astro.props;
---
<div class="citation">
  <div class="cite-row">
    <p class="cite-text" data-cite>{apa}</p>
    <button type="button" class="copy" data-copy="apa">Copy</button>
  </div>
  {bibtex && (
    <details>
      <summary>BibTeX</summary>
      <div class="cite-row">
        <pre data-bib>{bibtex}</pre>
        <button type="button" class="copy" data-copy="bib">Copy</button>
      </div>
    </details>
  )}
  <p class="visually-hidden" aria-live="polite" data-status></p>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.citation').forEach((root) => {
    const status = root.querySelector('[data-status]');
    root.querySelectorAll<HTMLButtonElement>('button.copy').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const src = root.querySelector(btn.dataset.copy === 'bib' ? '[data-bib]' : '[data-cite]');
        try {
          await navigator.clipboard.writeText(src?.textContent?.trim() ?? '');
          btn.textContent = 'Copied';
          if (status) status.textContent = 'Citation copied to clipboard';
          setTimeout(() => (btn.textContent = 'Copy'), 1800);
        } catch {
          btn.textContent = 'Select & copy';
        }
      });
    });
  });
</script>
<style>
  .citation { border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding-block: 1.1rem; }
  .cite-row { display: flex; gap: 1rem; align-items: flex-start; justify-content: space-between; }
  .cite-text { font-size: 1.02rem; line-height: 1.55; min-width: 0; overflow-wrap: anywhere; }
  pre { font: 0.78rem/1.5 var(--mono); white-space: pre-wrap; word-break: break-word; margin: 0.6rem 0 0; background: var(--paper-2) !important; color: var(--text) !important; padding: 0.8rem 1rem; flex: 1; min-width: 0; }
  .copy {
    flex: none; font: 500 0.8rem/1 var(--sans); padding: 0.55rem 0.8rem; background: transparent;
    color: var(--text); border: 1px solid var(--rule-strong); border-radius: 2px; cursor: pointer;
  }
  .copy:hover { border-color: var(--ink); }
  details { margin-top: 0.9rem; }
  summary { font: 500 0.85rem/1.3 var(--sans); color: var(--text-muted); cursor: pointer; }
  details .copy { margin-top: 0.6rem; }
</style>
