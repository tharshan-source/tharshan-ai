---
import { SITE } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap inner">
    <p>tharshan.ai — {SITE.footerLine.toLowerCase()}</p>
    <ul>
      <li><a href="/about">about</a></li>
      <li><a href={SITE.linkedin} rel="me noopener" target="_blank">contact ↗<span class="visually-hidden"> (LinkedIn, opens in a new tab)</span></a></li>
      <li><a href="/rss.xml">rss</a></li>
      <li><span>© {year} {SITE.fullName.toLowerCase()}</span></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer { margin-top: clamp(5rem, 10vw, 8rem); border-top: 1px solid var(--rule); }
  .inner {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem 2rem;
    padding-block: 2rem 3rem; font: 400 0.78rem/1.8 var(--mono); color: var(--faint);
  }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 1.25rem; }
  a { color: var(--muted); text-decoration: none; }
  a:hover { color: var(--accent-2); }
</style>
