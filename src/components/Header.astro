---
import { NAV, SITE } from '../site.config';
import { cleanPath } from '../lib/content';
const current = cleanPath(Astro.url.pathname);
const isActive = (href: string) => current === href || current.startsWith(href + '/');
---

<header class="site-header">
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label={`${SITE.name}, home`}>tharshan.ai<span class="caret" aria-hidden="true">_</span></a>
    <nav aria-label="Primary">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
        <li>
          <a class="out" href={SITE.linkedin} rel="me noopener" target="_blank">Contact <span aria-hidden="true">↗</span><span class="visually-hidden"> (LinkedIn, opens in a new tab)</span></a>
        </li>
      </ul>
    </nav>
    <button class="theme" type="button" aria-label="Switch to light theme" title="Switch theme">
      <span class="t-dark">dark</span><span class="sep" aria-hidden="true"> / </span><span class="t-light">light</span>
    </button>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme');
  const root = document.documentElement;
  const label = () => {
    const t = root.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
    btn?.setAttribute('aria-label', t === 'dark' ? 'Theme: dark. Switch to light theme' : 'Theme: light. Switch to dark theme');
  };
  label();
  btn?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', next);
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#f3f0e8' : '#0d0f10');
    try { localStorage.setItem('theme', next); } catch {}
    label();
  });
</script>

<style>
  .site-header { border-bottom: 1px solid var(--rule); }
  .bar { display: flex; align-items: baseline; gap: 0.75rem 2rem; padding-block: 1.25rem; }
  .wordmark { font: 500 1rem/1 var(--mono); letter-spacing: -0.01em; text-decoration: none; color: var(--text); white-space: nowrap; }
  .wordmark .caret { color: var(--accent); }
  .wordmark:hover { color: var(--text); }
  .wordmark:hover .caret { color: var(--accent-2); }
  nav { margin-left: auto; }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.2rem 1.4rem; }
  nav a {
    font: 400 0.74rem/1 var(--mono); letter-spacing: 0.07em; text-transform: uppercase;
    color: var(--muted); text-decoration: none; padding-block: 0.4rem; display: inline-block; white-space: nowrap;
  }
  nav a:not(.out)::before { content: '[ '; }
  nav a:not(.out)::after { content: ' ]'; }
  nav a:not(.out)::before, nav a:not(.out)::after { color: transparent; transition: color 120ms ease; }
  nav a:hover { color: var(--text); }
  nav a:not(.out):hover::before, nav a:not(.out):hover::after { color: var(--rule-2); }
  nav a[aria-current='page'] { color: var(--text); }
  nav a[aria-current='page']::before, nav a[aria-current='page']::after { color: var(--accent); }
  nav .out span[aria-hidden] { color: var(--accent); }

  /* Theme: a utility, separated from navigation by a hairline */
  .theme {
    font: 400 0.74rem/1 var(--mono); color: var(--faint); background: none; border: 0;
    border-left: 1px solid var(--rule); padding: 0.4rem 0 0.4rem 1.4rem; cursor: pointer; white-space: nowrap;
  }
  .theme .sep { color: var(--rule-2); }
  .theme:hover { color: var(--muted); }
  .theme:focus-visible { background: var(--inv-bg); color: var(--inv-fg); }
  :global([data-theme='dark']) .theme .t-dark,
  :global([data-theme='light']) .theme .t-light { color: var(--accent); }

  /* Narrow desktop: let the nav wrap under the wordmark */
  @media (max-width: 64rem) {
    .bar { display: grid; grid-template-columns: 1fr auto; row-gap: 0.75rem; }
    nav { grid-column: 1 / -1; grid-row: 2; margin-left: 0; }
    nav ul { justify-content: flex-start; }
    nav a:not(.out)::before { content: ''; }
    nav a:not(.out)::after { content: ''; }
    nav a[aria-current='page'] { color: var(--accent); }
    .theme { grid-column: 2; grid-row: 1; border-left: 0; padding-left: 0; }
  }

  /* Mobile: an intentional two-column grid of subjects, research, contact */
  @media (max-width: 40rem) {
    .bar { padding-block: 1.1rem 0.9rem; }
    nav ul { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
    nav li { border-top: 1px solid var(--rule); }
    nav a { display: block; padding-block: 0.75rem; font-size: 0.72rem; }
  }
</style>
