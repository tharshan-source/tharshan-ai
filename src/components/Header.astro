---
import { NAV, SITE } from '../site.config';
import { cleanPath } from '../lib/content';
const current = cleanPath(Astro.url.pathname);
const isActive = (href: string) => current === href || current.startsWith(href + '/');
---

<header class="site-header">
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label={`${SITE.name}, home`}>tharshan.ai<span class="caret" aria-hidden="true">_</span></a>
    <nav aria-label="Primary">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label.toLowerCase()}</a>
          </li>
        ))}
        <li>
          <a class="out" href={SITE.linkedin} rel="me noopener" target="_blank">linkedin <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--rule); }
  .bar { display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem 2rem; flex-wrap: wrap; padding-block: 1.25rem; }
  .wordmark { font: 500 1rem/1 var(--mono); letter-spacing: -0.01em; text-decoration: none; color: var(--text); }
  .wordmark .caret { color: var(--accent); }
  .wordmark:hover { color: var(--text); }
  .wordmark:hover .caret { color: var(--accent-2); }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.2rem 1.3rem; }
  nav a { font: 400 0.85rem/1 var(--mono); color: var(--muted); text-decoration: none; padding-block: 0.4rem; display: inline-block; }
  nav a:not(.out)::before { content: '[ '; }
  nav a:not(.out)::after { content: ' ]'; }
  nav a:not(.out)::before, nav a:not(.out)::after { color: transparent; transition: color 120ms ease; }
  nav a:hover { color: var(--text); }
  nav a:not(.out):hover::before, nav a:not(.out):hover::after { color: var(--rule-2); }
  nav a[aria-current='page'] { color: var(--text); }
  nav a[aria-current='page']::before, nav a[aria-current='page']::after { color: var(--accent); }
  nav .out span[aria-hidden] { color: var(--accent); }
  @media (max-width: 40rem) {
    .bar { flex-direction: column; align-items: flex-start; padding-block: 1.1rem 0.7rem; }
    nav ul { gap: 0 1.1rem; }
    nav a { font-size: 0.82rem; padding-block: 0.5rem; }
    nav a:not(.out):not([aria-current])::before, nav a:not(.out):not([aria-current])::after { content: none; }
  }
</style>
