---
import type { Research } from '../lib/content';
import { slugOf } from '../lib/content';
interface Props { entry: Research; spec?: boolean }
const { entry, spec = false } = Astro.props;
const { title, description, venue, year, authors, type, volume, doi } = entry.data;
const surnames = authors.map((a) => a.split(' ').slice(-1)[0]).join(', ');
const href = `/research/${slugOf(entry)}`;
---
<li class:list={['entry', 'res', { 'res--spec': spec }]}>
  <div class="entry-inner">
    <p class="meta stack"><span class="a">{type.toLowerCase().includes('journal') ? 'peer-reviewed' : type.toLowerCase()}</span><span>{year}</span></p>
    <div>
      <h3 class="entry-title"><a href={href}>{title}</a></h3>
      <p class="entry-desc">{description}</p>
    </div>
    {spec ? (
      <dl class="spec spec--ruled">
        <dt>journal</dt><dd>{venue}</dd>
        <dt>year</dt><dd>{year}{volume && <> · vol. {volume}</>}</dd>
        <dt>authors</dt><dd>{surnames}</dd>
        {doi && <><dt>doi</dt><dd><a href={`https://doi.org/${doi}`} rel="noopener">{doi}</a></dd></>}
      </dl>
    ) : (
      <p class="meta entry-end"><span>{venue}</span></p>
    )}
  </div>
</li>
<style>
  .entry-title a { text-decoration: none; }
  .entry-inner:hover .entry-title { color: var(--accent-2); }
  @media (min-width: 60rem) {
    .res--spec .entry-inner { grid-template-columns: var(--side) minmax(0, 1fr) 24rem; align-items: start; }
    .res:not(.res--spec) .entry-inner { grid-template-columns: var(--side) minmax(0, 1fr) 12rem; }
  }
  .res--spec .entry-title { font-size: var(--step-2); }
</style>
