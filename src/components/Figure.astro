---
/**
 * <Figure src={import('./chart.png')} alt="…" caption="…" />
 * Optimised, responsive image with an optional caption.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption?: string; wide?: boolean }
const { src, alt, caption } = Astro.props;
---
<figure>
  <Image src={src} alt={alt} widths={[480, 800, 1280]} sizes="(min-width: 44rem) 40rem, 100vw" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
