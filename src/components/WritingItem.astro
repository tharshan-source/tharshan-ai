---
import type { Writing } from '../lib/content';
import { slugOf, readingTime, dotDate, isoDate } from '../lib/content';
import { topicTitle } from '../lib/topics';
interface Props { entry: Writing; showTopic?: boolean }
const { entry } = Astro.props;
const { title, description, date, format, topic, draft } = entry.data;
const { showTopic = true } = Astro.props;
const minutes = readingTime(entry.body);
---
<li class="entry">
  <a href={`/writing/${slugOf(entry)}`}>
    <p class="meta"><time datetime={isoDate(date)}>{dotDate(date)}</time><span class="a">{format}</span>{showTopic && <span>{topicTitle(topic).toLowerCase()}</span>}</p>
    <div>
      <h3 class="entry-title">{title}{draft && <span class="draft mono"> draft</span>}</h3>
      <p class="entry-desc">{description}</p>
    </div>
    <p class="meta entry-end">{minutes && <span>{minutes} min</span>}</p>
  </a>
</li>
<style>.draft { color: var(--accent); font-size: 0.7rem; vertical-align: middle; }</style>
