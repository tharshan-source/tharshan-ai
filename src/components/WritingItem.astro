---
import type { Writing } from '../lib/content';
import { slugOf, readingTime, formatDate, isoDate } from '../lib/content';
interface Props { entry: Writing }
const { entry } = Astro.props;
const { title, description, date, category, draft } = entry.data;
const minutes = readingTime(entry.body);
---
<li class="entry">
  <a href={`/writing/${slugOf(entry)}`}>
    <div class="entry-side"><span class="tag tag--accent">{category}</span></div>
    <div>
      <h3 class="entry-title">{title}{draft && <span class="draft"> (draft)</span>}</h3>
      <p class="entry-desc">{description}</p>
      <p class="meta">
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        {minutes && <span>{minutes} min read</span>}
      </p>
    </div>
  </a>
</li>
<style>.draft { color: var(--accent); font-size: 0.8em; }</style>
