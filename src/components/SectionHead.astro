---
/** Section marker: "01 / writing ─────── all →" */
interface Props { title: string; n?: string; href?: string; linkLabel?: string; id?: string }
const { title, n, href, linkLabel = 'all', id } = Astro.props;
---
<div class="marker">
  <h2 id={id}>{n && <><span class="n">{n}</span> / </>}{title.toLowerCase()}</h2>
  <span class="line" aria-hidden="true"></span>
  {href && <a href={href}>{linkLabel} →</a>}
</div>
