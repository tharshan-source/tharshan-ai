---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <header class="wrap page-head">
    <p class="mono kicker"><span class="a">404</span> / not found</p>
    <h1>This page doesn’t exist.</h1>
    <p class="lede">It may have moved, or the link may be mistyped. Try the <a href="/">home page</a>, <a href="/writing">writing</a> or <a href="/research">research</a>.</p>
  </header>
</Base>
<style>.lede a { color: var(--text); text-decoration-color: var(--accent); }</style>
