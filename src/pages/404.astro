---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <header class="wrap page-head">
    <p class="label">404</p>
    <h1>This page doesn’t exist.</h1>
    <p class="lede">It may have moved, or the link may be mistyped. Try the <a href="/">home page</a>, <a href="/writing">writing</a> or <a href="/research">research</a>.</p>
  </header>
</Base>
<style>.label { margin-bottom: 1rem; }</style>
