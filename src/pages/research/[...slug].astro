---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Citation from '../../components/Citation.astro';
import Abstract from '../../components/Abstract.astro';
import { getResearch, slugOf, isoDate, dotDate } from '../../lib/content';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  return (await getResearch()).map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const slug = slugOf(entry);
const doiUrl = d.doi ? `https://doi.org/${d.doi}` : d.url;
const volumeLine = [d.volume && `Volume ${d.volume}`, d.issue && `Issue ${d.issue}`, d.articleNumber && `Article ${d.articleNumber}`, d.pages && `pp. ${d.pages}`].filter(Boolean).join(', ');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: d.title,
  name: d.title,
  author: d.authors.map((name) => (name === SITE.fullName ? { '@type': 'Person', name, url: SITE.url, sameAs: [SITE.linkedin] } : { '@type': 'Person', name })),
  datePublished: isoDate(d.date),
  isPartOf: { '@type': 'PublicationIssue', ...(d.issue && { issueNumber: d.issue }), isPartOf: { '@type': ['PublicationVolume', 'Periodical'], name: d.venue, ...(d.volume && { volumeNumber: d.volume }) } },
  ...(d.doi && { identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: d.doi }, sameAs: doiUrl }),
  ...(d.abstract && { abstract: d.abstract }),
  keywords: d.keywords.join(', '),
  url: `${SITE.url}/research/${slug}`,
};
---
<Base title={d.title} description={d.description} type="article" image={`/og/research/${slug}.png`} published={d.date} tags={d.keywords} jsonLd={jsonLd}>
  <Fragment slot="head">
    <meta name="citation_title" content={d.title} />
    {d.authors.map((a) => <meta name="citation_author" content={a} />)}
    <meta name="citation_publication_date" content={d.date.toISOString().slice(0, 10).replace(/-/g, '/')} />
    <meta name="citation_journal_title" content={d.venue} />
    {d.volume && <meta name="citation_volume" content={d.volume} />}
    {d.articleNumber && <meta name="citation_firstpage" content={d.articleNumber} />}
    {d.doi && <meta name="citation_doi" content={d.doi} />}
    {d.pdf && <meta name="citation_pdf_url" content={new URL(d.pdf, SITE.url).href} />}
  </Fragment>
  <article class="wrap paper">
    <header class="head with-side">
      <p class="meta stack"><a class="a" href="/research">research</a><span>{d.type.toLowerCase()}</span></p>
      <div>
        <h1>{d.title}</h1>
        <dl class="spec facts">
          <dt>authors</dt><dd>{d.authors.join(', ')}</dd>
          <dt>journal</dt><dd>{d.venue}{volumeLine && <>, {volumeLine.toLowerCase()}</>}</dd>
          <dt>published</dt><dd>online {dotDate(d.date)}{d.issueDate && <> · print {d.issueDate.toLowerCase()}</>}</dd>
          {d.sample && <><dt>sample</dt><dd>{d.sample}</dd></>}
          {d.method && <><dt>method</dt><dd>{d.method}</dd></>}
          {d.doi && <><dt>doi</dt><dd><a href={doiUrl} rel="noopener">{d.doi}</a></dd></>}
        </dl>
        <p class="actions">
          {doiUrl && <a class="btn btn--signal" href={doiUrl} rel="noopener">read at the publisher <span aria-hidden="true">↗</span></a>}
          {d.pdf && <a class="btn" href={d.pdf} download>download pdf</a>}
          <a class="btn" href="#cite">cite this paper</a>
        </p>
      </div>
    </header>

    <div class="with-side body">
      <span></span>
      <div>
        <div class="prose numbered">
          <Content components={{ Abstract }} />
        </div>

        <section class="prose cite" id="cite" aria-labelledby="h-cite">
          <h2 id="h-cite">Citation</h2>
          <Citation apa={d.citation.apa} bibtex={d.citation.bibtex} />
        </section>

        <section class="prose access" aria-labelledby="h-access">
          <h2 id="h-access">Access</h2>
          {d.pdf ? (
            <p>The paper is available from the publisher via its <a href={doiUrl} rel="noopener">DOI</a>, and as a <a href={d.pdf} download>PDF</a>.</p>
          ) : (
            <p>The published version is available from the publisher via its <a href={doiUrl} rel="noopener">DOI</a>. It is not open access, so the publisher’s PDF is not hosted here.</p>
          )}
        </section>
      </div>
    </div>
  </article>
</Base>

<style>
  .paper { padding-top: clamp(3rem, 8vw, 6rem); }
  .head .meta { padding-top: 0.8rem; }
  .head .meta a { text-decoration: none; }
  h1 { font-size: var(--step-3); letter-spacing: -0.025em; line-height: 1.06; max-width: 22ch; }
  .facts { margin-top: 2.25rem; padding-top: 1.1rem; border-top: 1px solid var(--rule); max-width: var(--measure); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .body { margin-top: clamp(3rem, 6vw, 4rem); }
  .cite, .access { margin-top: 3.5rem; }
  .cite h2, .access h2 { font: 400 0.78rem/1 var(--mono); color: var(--faint); text-transform: lowercase; letter-spacing: 0; margin-bottom: 1rem; }
  .cite h2::before, .access h2::before { content: '// '; }
  .access p { color: var(--muted); font-size: 1rem; }
</style>
