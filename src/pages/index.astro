---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import WritingItem from '../components/WritingItem.astro';
import FeaturedWriting from '../components/FeaturedWriting.astro';
import ResearchItem from '../components/ResearchItem.astro';
import VideoItem from '../components/VideoItem.astro';
import { getWriting, getResearch, getVideos, pick, dotDate } from '../lib/content';
import { SITE } from '../site.config';

const allWriting = await getWriting();
const [featured, ...moreWriting] = pick(allWriting, 5);
const research = pick(await getResearch(), 2);
const videos = pick(await getVideos(), 3);
const updated = dotDate(new Date());

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'tharshan.ai', url: SITE.url, author: { '@id': `${SITE.url}/#person` } },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${SITE.url}/#person`,
    name: SITE.fullName,
    alternateName: SITE.name,
    url: SITE.url,
    sameAs: [SITE.linkedin],
    worksFor: { '@type': 'Organization', name: 'Cloud Capital' },
  },
];
---

<Base jsonLd={jsonLd}>
  <div class="wrap hero">
    <p class="mono kicker"><span class="a">00</span> / index — updated {updated}</p>
    <h1>AI is <span class="nw">human-wrapped.</span></h1>
    <p class="descriptor">Musings on AI’s impact on governance, economics and infrastructure, informed by lived experience.</p>
  </div>

  <section class="wrap section" aria-labelledby="h-writing">
    <SectionHead id="h-writing" n="01" title="Writing" href={allWriting.length > 1 ? '/writing' : undefined} linkLabel={`all ${allWriting.length}`} />
    {featured ? (
      <>
        <FeaturedWriting entry={featured} />
        {moreWriting.length > 0 && <ul class="entries">{moreWriting.map((entry) => <WritingItem entry={entry} />)}</ul>}
      </>
    ) : (
      <p class="mono pending">// first essays in progress — <a href="/rss.xml">rss</a></p>
    )}
  </section>

  <section class="wrap section" aria-labelledby="h-research">
    <SectionHead id="h-research" n="02" title="Research" href="/research" />
    <ul class="entries">{research.map((entry) => <ResearchItem entry={entry} />)}</ul>
  </section>

  <section class="wrap section" aria-labelledby="h-videos">
    <SectionHead id="h-videos" n="03" title="Videos" href="/videos" />
    <ul class="video-grid">{videos.map((entry) => <VideoItem entry={entry} compact />)}</ul>
  </section>

  <section class="wrap section" aria-label="About the author">
    <p class="mono context">
      <span class="a">//</span> written by tharshan: ai &amp; cloud economics at cloud capital · founded ai launchpad · published in finance research letters — <a href="/about">about →</a>
    </p>
  </section>
</Base>

<style>
  .hero { padding-top: clamp(4rem, 12vw, 9.5rem); padding-bottom: clamp(1rem, 3vw, 2rem); }
  .kicker { margin-bottom: clamp(2rem, 4vw, 3rem); }
  h1 {
    font-size: clamp(2.2rem, 0.5rem + 8.6vw, 7.25rem); line-height: 0.98; letter-spacing: -0.04em;
    font-weight: 400; max-width: 12ch; color: var(--text);
  }
  h1 .nw { white-space: nowrap; }
  .descriptor {
    margin-top: clamp(1.75rem, 3vw, 2.5rem); max-width: 32rem;
    font-size: var(--step-1); line-height: 1.5; color: var(--muted);
  }

  .pending { padding-top: 0.25rem; }
  .pending a { color: var(--accent); text-decoration: none; }
  .pending a:hover { text-decoration: underline; }

  .video-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0 3rem; }
  @media (min-width: 60rem) { .video-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .video-grid > :global(.video:first-child) { border-top: 0; }
  @media (min-width: 60rem) { .video-grid > :global(.video) { border-top: 0; } .video-grid :global(a) { padding-top: 0.25rem; } }

  .context { max-width: 52rem; border-top: 1px solid var(--rule); padding-top: 1.25rem; line-height: 1.7; }
  .context a { color: var(--accent); text-decoration: none; white-space: nowrap; }
  .context a:hover { text-decoration: underline; }
</style>
