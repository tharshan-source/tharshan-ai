---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import WritingItem from '../components/WritingItem.astro';
import FeaturedWriting from '../components/FeaturedWriting.astro';
import ResearchItem from '../components/ResearchItem.astro';
import VideoItem from '../components/VideoItem.astro';
import { getWriting, getResearch, getVideos, pick, dotDate } from '../lib/content';
import { SITE } from '../site.config';

const allWriting = await getWriting();
const [featured, ...moreWriting] = pick(allWriting, 5);
const research = pick(await getResearch(), 2);
const videos = pick(await getVideos(), 3);
const updated = dotDate(new Date());

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'tharshan.ai', url: SITE.url, author: { '@id': `${SITE.url}/#person` } },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${SITE.url}/#person`,
    name: SITE.fullName,
    alternateName: SITE.name,
    url: SITE.url,
    sameAs: [SITE.linkedin],
    worksFor: { '@type': 'Organization', name: 'Cloud Capital' },
  },
];
---

<Base jsonLd={jsonLd}>
  <div class="wrap intro">
    <p class="mono kicker"><span class="a">00</span> / index — updated {updated}</p>
    <h1>Hi, I’m Tharshan.</h1>
    <p class="thesis">
      I build in AI, and I study what shapes its outcomes: <em>the people, incentives and governance</em> wrapped around the models.
    </p>
    <div class="body">
      <p>
        I’m currently at Cloud Capital, working with CFOs, CTOs and investors to underwrite AI and cloud infrastructure spend.
        Before that I founded AI Launchpad, which accelerated 350+ startups from 90+ countries, and built and exited
        a bootstrapped AI platform with friends. My doctoral research is published in <a href="/research/female-representation-boards-carbon-emissions"><em>Finance Research Letters</em></a>.
      </p>
      <p>This site is where I publish research, essays and notes on how AI is built, financed and governed.</p>
    </div>
  </div>

  <section class="wrap section" aria-labelledby="h-writing">
    <SectionHead id="h-writing" n="01" title="Writing" href={allWriting.length > 1 ? '/writing' : undefined} linkLabel={`all ${allWriting.length}`} />
    {featured ? (
      <>
        <FeaturedWriting entry={featured} />
        {moreWriting.length > 0 && <ul class="entries">{moreWriting.map((entry) => <WritingItem entry={entry} />)}</ul>}
      </>
    ) : (
      <div class="empty with-side">
        <p class="mono">empty_</p>
        <div>
          <p>The first essays and research notes are being written and will appear here.</p>
          <p class="mono">follow along via <a href="/rss.xml">rss</a> or <a href={SITE.linkedin} rel="noopener" target="_blank">linkedin ↗</a></p>
        </div>
      </div>
    )}
  </section>

  <section class="wrap section" aria-labelledby="h-research">
    <SectionHead id="h-research" n="02" title="Research" href="/research" />
    <ul class="entries">{research.map((entry) => <ResearchItem entry={entry} spec />)}</ul>
  </section>

  <section class="wrap section" aria-labelledby="h-videos">
    <SectionHead id="h-videos" n="03" title="Videos" href="/videos" />
    <ul class="video-grid">{videos.map((entry) => <VideoItem entry={entry} compact />)}</ul>
  </section>

  <section class="wrap section" aria-labelledby="h-background">
    <SectionHead id="h-background" n="04" title="Background" href="/about" linkLabel="about" />
    <dl class="ledger">
      <div><dt>now</dt><dd><strong>Cloud Capital.</strong> Working with CFOs, CTOs and investors to underwrite AI and cloud infrastructure spend.</dd></div>
      <div><dt>founded</dt><dd><strong>AI Launchpad.</strong> An accelerator for AI founders, built at Paddle: 350+ startups from 90+ countries.</dd></div>
      <div><dt>built</dt><dd><strong>A bootstrapped AI platform</strong>, built with friends and exited.</dd></div>
      <div><dt>research</dt><dd><strong>Doctoral research</strong> at Paris School of Business on governance and corporate carbon outcomes, published in <em>Finance Research Letters</em>.</dd></div>
      <div><dt>advise</dt><dd>Builders, investors and governments on policy and investment decisions in <strong>human-wrapped AI</strong>.</dd></div>
    </dl>
  </section>
</Base>

<style>
  .intro { padding-top: clamp(3.5rem, 10vw, 8rem); }
  .kicker { margin-bottom: 2rem; }
  h1 { font: 400 var(--step-1)/1.3 var(--mono); letter-spacing: 0; color: var(--muted); font-size: 0.95rem; margin-bottom: 1.25rem; }
  .thesis {
    font-size: clamp(2rem, 1.2rem + 3.4vw, 3.6rem); line-height: 1.12; letter-spacing: -0.02em;
    max-width: 22ch; color: var(--text);
  }
  .thesis em { font-style: italic; }
  .body { margin-top: 2rem; max-width: 36rem; color: var(--muted); font-size: 1.05rem; line-height: 1.65; }
  .body p + p { margin-top: 0.9em; }
  .body a { color: var(--text); text-decoration-color: var(--accent); }
  .body a:hover { color: var(--accent-2); }

  .empty p.mono { color: var(--accent); }

  .video-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0 3rem; }
  @media (min-width: 60rem) { .video-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .video-grid > :global(.video:first-child) { border-top: 0; }
  @media (min-width: 60rem) { .video-grid > :global(.video) { border-top: 0; } .video-grid :global(a) { padding-top: 0.25rem; } }

  .ledger { margin: 0; border-top: 1px solid var(--rule); }
  .ledger > div { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.2rem 3rem; padding-block: 1rem; border-bottom: 1px solid var(--rule); }
  @media (min-width: 60rem) { .ledger > div { grid-template-columns: var(--side) minmax(0, 1fr); } }
  dt { font: 400 0.78rem/1.9 var(--mono); color: var(--accent); }
  dd { margin: 0; line-height: 1.55; max-width: 44rem; color: var(--muted); }
  dd strong { font-weight: 500; color: var(--text); }
</style>
