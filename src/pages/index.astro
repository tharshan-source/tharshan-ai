---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getResearch, getWriting, getVideos, pick, slugOf, dotDate } from '../lib/content';
import { TOPIC_LIST } from '../lib/topics';
import { SITE } from '../site.config';

const doors = TOPIC_LIST;
const research = await getResearch();
const [paper] = pick(research, 1);
const writing = await getWriting(), videos = await getVideos();
const last = [...writing, ...videos].map((e) => e.data.date).sort((a, b) => b.valueOf() - a.valueOf())[0];

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'tharshan.ai', url: SITE.url, description: SITE.description, author: { '@id': `${SITE.url}/#person` } },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${SITE.url}/#person`,
    name: SITE.fullName,
    alternateName: SITE.name,
    url: SITE.url,
    sameAs: [SITE.linkedin],
    worksFor: { '@type': 'Organization', name: 'Cloud Capital' },
  },
];
---

<Base jsonLd={jsonLd}>
  <div class="wrap hero">
    <h1>AI is <span class="nw">human-wrapped.</span></h1>
    <p class="descriptor">Musings on AI’s impact on economics, governance, and infrastructure, informed by lived experiences.</p>
    <p class="sys status">3 subjects · {writing.length} essays · {videos.length} videos · {research.length} {research.length === 1 ? 'paper' : 'papers'}{last && <> · last record {dotDate(last)}</>}</p>
  </div>

  <nav class="wrap doors" aria-label="Subjects">
    <ol>
      {doors.map((d) => (
        <li>
          <a href={`/${d.slug}`} class="door acq">
            <i class="k tl"></i><i class="k tr"></i><i class="k bl"></i><i class="k br"></i>
            <span class="n mono">{d.n} /<span class="obsv"> observed: {d.observed}</span></span>
            <span class="body">
              <span class="title">{d.title.split(' ').map((w, i) => <>{i > 0 && ' '}<span class="nw">{w}</span></>)}</span>
              <span class="desc">{d.descriptor}</span>
            </span>
            {d.visual ? (
              <span class="vp acq signal" aria-hidden="true">
                <Image src={d.visual.fragment} alt="" widths={[240, 480]} sizes="15rem" loading="lazy" />
                <i class="k tl"></i><i class="k tr"></i><i class="k bl"></i><i class="k br"></i>
              </span>
            ) : (
              <span class="go mono"><span class="explore">explore →</span></span>
            )}
          </a>
        </li>
      ))}
    </ol>
  </nav>

  {paper && (
    <section class="wrap research" aria-labelledby="h-research">
      <p class="mono label-line"><span class="a">research</span> / {paper.data.venue.toLowerCase()}</p>
      <h2 id="h-research"><a href={`/research/${slugOf(paper)}`}>{paper.data.title}</a></h2>
      <p class="r-meta mono">published peer-reviewed research · {paper.data.year} — <a href="/research">view research →</a></p>
    </section>
  )}

  <div class="wrap"><p class="mono context"><span class="a">//</span> informed by building, published research, and work with operators, investors and governments.</p></div>
</Base>

<style>
  .hero { padding-top: clamp(4.5rem, 13vw, 10rem); padding-bottom: clamp(3.5rem, 8vw, 6rem); }
  h1 {
    font-size: clamp(2.2rem, 0.5rem + 8.6vw, 7.25rem); line-height: 0.98; letter-spacing: -0.04em;
    font-weight: 400; max-width: 12ch; color: var(--text);
  }
  h1 .nw, .title .nw { white-space: nowrap; }
  .descriptor { margin-top: clamp(1.75rem, 3vw, 2.5rem); max-width: 32rem; font-size: var(--step-1); line-height: 1.5; color: var(--muted); }

  /* Three editorial doors: wide ruled rows, like chapters in a contents page */
  .doors ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .doors li { border-bottom: 1px solid var(--rule); }
  .doors a {
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.6rem 3rem;
    padding-block: clamp(1.5rem, 3vw, 2.25rem); text-decoration: none; color: inherit;
  }
  @media (min-width: 60rem) { .doors a { grid-template-columns: var(--side) minmax(0, 1fr) 10rem; align-items: baseline; } }
  .n { font-size: 0.78rem; color: var(--accent); }
  .title { display: block; font-size: clamp(1.9rem, 1.1rem + 3vw, 3.4rem); line-height: 1.05; letter-spacing: -0.028em; transition: color 120ms ease; }
  .desc { display: block; margin-top: 0.65rem; max-width: 34rem; color: var(--muted); font-size: 1.02rem; line-height: 1.5; }
  .go { display: flex; gap: 1rem; justify-content: space-between; font-size: 0.78rem; color: var(--faint); }
  @media (min-width: 60rem) { .go { flex-direction: column; align-items: flex-end; gap: 0.5rem; } }
  .explore { color: var(--muted); transition: color 120ms ease; }
  .doors a:hover .title { color: var(--accent-2); }
  .doors a:hover .explore { color: var(--accent); }
  .doors a:hover .n::after { content: '_'; }

  /* One compact research line */
  .research { padding-top: clamp(4rem, 8vw, 6rem); }
  .label-line { font-size: 0.78rem; color: var(--faint); margin-bottom: 0.9rem; }
  .research h2 { font-size: var(--step-2); line-height: 1.2; max-width: 30ch; }
  .research h2 a { text-decoration: none; }
  .research h2 a:hover { color: var(--accent-2); }
  .r-meta { margin-top: 0.8rem; font-size: 0.78rem; color: var(--faint); }
  .r-meta a { color: var(--accent); text-decoration: underline; text-underline-offset: 0.2em; white-space: nowrap; }
  .r-meta a:hover { color: var(--accent-2); }

  .status { margin-top: 1.6rem; }
  /* A subject row is acquired on hover/focus; corners settle a few pixels into place. */
  .door > .k { --k: transparent; }
  .door:hover > .k, .door:focus-visible > .k { --k: var(--accent); transform: none; }
  .door > .k.tl { transform: translate(-6px, -2px); } .door > .k.tr { transform: translate(6px, -2px); }
  .door > .k.bl { transform: translate(-6px, 2px); } .door > .k.br { transform: translate(6px, 2px); }
  .obsv { color: var(--faint); letter-spacing: 0.04em; }
  /* Optional viewport into the subject image (desktop only) */
  .vp { display: none; }
  @media (min-width: 60rem) {
    .doors a:has(.vp) { grid-template-columns: var(--side) minmax(0, 1fr) 15rem; align-items: center; }
    .vp { display: block; width: 15rem; aspect-ratio: 16 / 9; overflow: hidden; }
    .vp :global(img) { width: 100%; height: 100%; object-fit: cover; opacity: 0.82; transition: opacity 160ms ease; }
    .door:hover .vp :global(img) { opacity: 1; }
    .vp .k { width: 0.6rem; height: 0.6rem; }
    .vp .k.tl { transform: translate(-2px, -2px); } .vp .k.br { transform: translate(2px, 2px); }
    .vp .k.tr { transform: translate(2px, -2px); } .vp .k.bl { transform: translate(-2px, 2px); }
    .door:hover .vp .k { transform: none; }
  }
  @media (max-width: 40rem) { .status, .obsv { display: none; } }
  @media (prefers-reduced-motion: reduce) { .door > .k, .vp :global(img) { transition: none; } }

  .context { padding-top: clamp(4rem, 8vw, 6rem); font-size: 0.78rem; color: var(--faint); max-width: 48rem; }
</style>
