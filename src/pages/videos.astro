---
import Base from '../layouts/Base.astro';
import VideoItem from '../components/VideoItem.astro';
import { getVideos } from '../lib/content';
import { SITE } from '../site.config';
const all = await getVideos();
---
<Base title="Video archive" description="Every short video on tharshan.ai, newest first.">
  <header class="wrap page-head">
    <p class="mono kicker"><span class="a">archive</span> / videos — {all.length} entries</p>
    <h1>Videos</h1>
    <p class="lede">Every video, newest first. Each one opens on the platform it was published on. For subjects, start with <a href="/ai-economics">AI Economics</a>, <a href="/ai-infrastructure">AI Infrastructure</a> or <a href="/human-wrapped-ai">Human-Wrapped AI</a>.</p>
  </header>
  <div class="wrap">
    <h2 class="visually-hidden">All videos</h2>
    <ul class="list">{all.map((entry) => <VideoItem entry={entry} />)}</ul>
    <p class="mono more"><a href={`${SITE.linkedin}recent-activity/videos/`} rel="noopener" target="_blank">all videos on linkedin ↗<span class="visually-hidden"> (opens in a new tab)</span></a></p>
  </div>
</Base>
<style>
  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .more { margin-top: 2rem; }
  .lede a { color: var(--text); text-decoration-color: var(--accent); }
  .more a { color: var(--accent); text-decoration: none; }
  .more a:hover { text-decoration: underline; }
</style>
