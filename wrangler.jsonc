// Cloudflare Pages configuration. The site is fully static (no server code).
// Production deploys happen automatically when you push to `main` on GitHub.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tharshan-ai",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-01"
}
