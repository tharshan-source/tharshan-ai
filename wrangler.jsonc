// Cloudflare Workers configuration (static assets only; no server code).
// Deploys happen automatically from GitHub via Cloudflare Workers Builds.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tharshan-ai",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": { "enabled": false }
}
